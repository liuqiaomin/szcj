<cu-custom bgColor="bg-gradual-green" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">发布信息</view>
</cu-custom>

<view class="cu-form-group margin-top">
  <textarea class="bg-gray" maxlength="-1" bindinput="textareaAInput" placeholder="发布点什么吧 招牌  二手 转让 闲置 都可以" value="{{description}}"> </textarea>
</view>
<view class="cu-bar bg-white margin-top">
  <view class="action">
    图片上传（可不传）
  </view>
  <view class="action">
    {{imgList.length}}/9
  </view>
</view>
<view class="cu-form-group">
  <view class="grid col-3 grid-square flex-sub">
    <view class="bg-img" wx:for="{{imgList}}" wx:key="{{index}}" wx:key="u" bindtap="ViewImage" data-url="{{imgList[index]}}">
      <image src='{{imgList[index]}}' mode='aspectFill'></image>
      <view class="cu-tag bg-red" catchtap="DelImg" data-index="{{index}}">
        <text class="cuIcon-close"></text>
      </view>
    </view>
    <view class="solids" bindtap="ChooseImage" wx:if="{{imgList.length<9}}">
      <text class="cuIcon-cameraadd"></text>
    </view>
  </view>
</view>
<view class="cu-tabbar-height"></view>
<view class=" newkf flex flex-direction">
  <button bind:tap="add" class="cu-btn round bg-yellow lg">发布</button>
</view>