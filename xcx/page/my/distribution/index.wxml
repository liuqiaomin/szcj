<cu-custom bgColor="bg-yellow" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">分销中心</view>
</cu-custom>
<view class="padding-sm" wx:if="{{XY}}">
  <view wx:if="{{User.distribution_status!='已通过'}}">
    <view class="cu-bar by bg-white solid-bottom">
      <view class='action'>
        <text class='cuIcon-titles text-orange '></text>{{User.distribution_status=='未申请'?'申请分销':User.distribution_status=='申请中'?'正在审核中':''}}
      </view>
    </view>
    <form catchsubmit="formSubmit" catchreset="formReset">
      <view class="cu-form-group ">
        <view class="title">姓名</view>
        <input placeholder="请输入您的姓名" name="distribution_name" value="{{User.distribution_name}}"></input>
      </view>
      <view class="cu-form-group ">
        <view class="title">手机号</view>
        <input placeholder="请输入您的手机号" name="distribution_phone" value="{{User.distribution_phone}}"></input>
      </view>
      <view class="cu-form-group ">
        <view class="title">支付宝账号</view>
        <input placeholder="请输入您的支付宝账号" name="distribution_alipay" value="{{User.distribution_alipay}}"></input>
      </view>
      <view class="cu-form-group xbyd">
        <view class="title">银行卡账号</view>
        <input placeholder="请输入您的银行卡账号" name="distribution_bank_card" value="{{User.distribution_bank_card}}"></input>
      </view>
      <view class="padding-sm flex flex-direction">
        <button formType="{{User.distribution_status=='未申请'?'submit':''}}" class="cu-btn bg-orange margin-tb-sm round lg"> {{User.distribution_status=='未申请'?'确认申请':User.distribution_status=='申请中'?'正在审核中':User.distribution_status=='已通过'?'分销码':''}}</button>
      </view>
    </form>
  </view>
  <view wx:if="{{User.distribution_status=='已通过'}}">
    <view class="padding flex text-center sby text-grey bg-white shadow-warp">

      <view class="flex flex-sub flex-direction solid-right" bind:tap="tx">
        <view style="font-size: 50rpx;" class=" text-orange cuIcon-pay"></view>
        <view class="margin-top-sm">
          申请提现</view>
      </view>
      <view class="flex flex-sub flex-direction solid-right" >
        <view class="text-xxl text-orange">{{User.commission}}</view>
        <view class="margin-top-sm">
          我的佣金</view>
      </view>
      <navigator hover-class="none" url="/page/my/distribution/commission_list" class="flex flex-sub flex-direction ">
        <view style="font-size: 50rpx;" class=" text-orange cuIcon-list"></view>
        <view class="margin-top-sm">
          佣金记录</view>
      </navigator>
    </view>
    <navigator url="/page/my/distribution/kh_list" class="cu-bar  bg-white solid-bottom">
      <view class='action'>
        <text class='cuIcon-titles text-orange '></text>我的客户
      </view>
      <view class='action'>
        <text class='cuIcon-right text-black'></text>
      </view>
    </navigator>
    <view>
      <image class="by" src="{{User.distribution_ma}}" style="width: 100%;" mode="widthFix" />
    </view>
    <view class="padding flex flex-direction">
      <button bind:tap="ViewImage" class="cu-btn bg-yellow round margin-tb-sm lg">分享推广码给客户</button>
      <button open-type="share" class="cu-btn bg-green round margin-tb-sm lg">分享小程序给客户</button>
    </view>
  </view>
</view>