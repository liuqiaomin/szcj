page{
  background-color: rgb(226, 223, 223);
}
.margin-lr-xs {
  margin-left: 20rpx;
  margin-right: 20rpx;
  padding: 13rpx;
}
.cu-list.menu-avatar>.cu-item {
  position: relative;
  display: flex;
  padding-right: 10rpx;
  height: 180rpx;
  background-color: var(--white);
  justify-content: flex-end;
  align-items: center;
}
.cu-form-group textarea {
  margin: 32rpx 0 30rpx;
  width: 100%;
  height: 200rpx !important;  
  line-height: 1.2em;
  flex: 1;
  font-size: 28rpx;
  border-radius: 10rpx;
  padding: 20rpx 20rpx 10rpx 20rpx;
}