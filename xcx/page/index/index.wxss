/* 滚动公告 */
@keyframes remindMessage {
  0% {
    -webkit-transform: translateX(90%);
  }

  100% {
    -webkit-transform: translateX(-180%);
  }
}

.tongzhi-text {
  font-size: 28rpx;
  animation: remindMessage 10s linear infinite;
  width: 100%;
  padding: 20rpx;
  display: block;
  z-index: 2;
}

/* 滚动公告 end*/





