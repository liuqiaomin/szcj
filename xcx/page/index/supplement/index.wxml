<cu-custom bgColor="bg-gradual-green" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">补充门店信息</view>
</cu-custom>
<view wx:if="{{XY}}">
  <view class="padding-sm" wx:if="{{VXY}}">
    <view class="cu-bar bg-white sby">
      <view class='action'>
        <text class='cuIcon-titles text-orange '></text> 上传门头照片
      </view>
    </view>
    <button class="bg-white" bind:tap="Doorsign">
      <view>
        <view wx:if="{{Doorsign}}">
          <image mode="aspectFill" src="{{Doorsign}}"></image>
        </view>
        <view wx:else class="cu-avatar xl " style="background-image:url('/images/mtz.png');"></view>
      </view>
    </button>
    <view class="cu-form-group  text-left">
      <view class="title">收货店名</view>
      <input placeholder="请输入您的收货店名" bindinput="name" value="{{name}}"></input>
    </view>
    <view class="cu-form-group  text-left">
      <view class="title">收货地址</view>
      <input placeholder="请输入您的收货地址" bindinput="address" value="{{address}}"></input>
    </view>
    <view class="cu-form-group xby text-left">
      <view class="title">收货电话</view>
      <input placeholder="请输入您的收货电话" bindinput="phone" value="{{phone}}" maxlength="11"></input>
    </view>
    <view class="fgx"></view>
    <view class="fgx"></view>
    <view class="cu-bar bg-white sby solid-bottom">
      <view class='action'>
        <text class='cuIcon-titles text-orange '></text> 上传/选择头像
      </view>
    </view>
    <button class="bg-white padding-sm " open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <view>
        <view wx:if="{{Avatar}}">
          <image class="avatar" src="{{Avatar}}"></image>
        </view>
        <view wx:else class="cu-avatar xl by" style="background-image:url('/images/upimg.png');"></view>
      </view>
    </button>
    <view class="cu-form-group  text-left">
      <view class="title">您的昵称</view>
      <input type="nickname" bindinput="Niche" value="{{Niche}}" class="weui-input" placeholder="请输入您的昵称" />
    </view>
    <view class="bg-white text-df xby text-red padding-sm"> 如果需要清除保存的数据 可以联系客服注销账号 </view>
    <view class="fgx"></view>
    <view class="checkbox" bind:tap="xybu">
      <view  style="padding: 20rpx;">
        <radio checked='{{xy2}}'></radio>
      </view>
      <view style="padding:  30rpx 0rpx 30rpx 0rpx;">请阅读用户协议 
      <text class="text-blue">用户协议</text></view>
    </view>
    <view class="fgx"></view>
    <view class="cu-tabbar-height"></view>
    <view class="padding-sm new">
      <view class=" flex flex-direction" bind:tap="up">
        <button class="cu-btn bg-green round margin-tb-sm lg">保存</button>
      </view>
    </view>
  </view>
  <view wx:else style="padding-top: 450rpx;">
    <view class="text-center padding text-red ">已提交门店信息,等待审核！</view>
    <view class="text-center padding text-red ">如需加急审核</view>
    <view bind:tap="freeTell" class="text-center padding text-red ">至首页联系客服或拨打电话 <text class="text-blue">13510398108</text></view>
  </view>
</view>