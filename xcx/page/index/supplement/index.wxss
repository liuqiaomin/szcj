.cu-avatar {
  font-variant: small-caps;
  margin: 0;
  padding: 0;
  display: inline-flex;
  text-align: center;
  justify-content: center;
  align-items: center;
  background-color: rgb(252, 250, 250);
  color: var(--white);
  white-space: nowrap;
  position: relative;
  width: 64rpx;
  height: 64rpx;
  background-size: cover;
  background-position: center;
  vertical-align: middle;
  font-size: 1.5em;
}

page {
  background-color: rgb(241, 240, 239);
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
}
