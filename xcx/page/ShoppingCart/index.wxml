<cu-custom bgColor="bg-gradual-green">
  <view slot="content">购物车</view>
</cu-custom>
<view>
  <view wx:for="{{list}}" wx:key="u" style="padding:  15rpx 15rpx 0rpx 15rpx;">
    <view class="cu-list menu-avatar by">
      <view class="cu-item">
        <image bind:tap="TZ" data-id="{{item.product_id}}"  class="cu-avatar by lg" bind:tap="TZ" data-id="{{item.product_id}}" src="{{item.product_main_image}}" mode="" />
        <view class="content flex-sub">
          <view   class="text-black text-bold" >
            <text class="text-cut" style="width:220px"> {{item.product_name}}</text>
            <text class="text-price text-red ">{{item.meet}}</text>
          </view>
          <view class="text-gray text-sm flex justify-between">
            {{item.product_specification}}
            | {{ item.product_unit}}
          </view>
          <view class="text-gray text-sm flex justify-between">
            <text class="line-through-text">{{item.unitprice}}</text>
            <text class="text-price text-sm  text-red">{{item.level_price}} </text>
            <view class="text-black text-bold">
              <text bind:tap="{{deleteb?'delete':''}}" data-item="{{item}}" class="cuIcon-move solids margin-lr-xs"></text>
              <text class=" margin-lr-xs ">{{item.product_quantity}}</text>
              <text bind:tap="add" data-item="{{item}}" class="cuIcon-add solids  margin-lr-xs"></text>
            </view>
          </view>

        </view>
      </view>
    </view>
  </view>
</view>
<view style="height: 110rpx;"></view>
<view wx:if="{{list.length==0}}">
  <image style="width: 100%;" src="/images/data.png" mode="widthFix" />
</view>
<view wx:if="{{meet>0}}" class="new cu-bar bg-white tabbar border shop">
  <view class="action" open-type="contact">
    <text class="text-price text-red" style="font-size: 40rpx;"></text>
    <text class=" text-bold  text-red " style="font-size: 30rpx;">{{meet}}</text>
  </view>
  <navigator url="/page/ShoppingCart/submitorder" class="bg-orange submit">结算</navigator>
</view>