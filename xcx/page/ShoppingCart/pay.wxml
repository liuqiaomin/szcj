<cu-custom bgColor="bg-gradual-green" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">收银台</view>
</cu-custom>
<view class="text-center padding " style="font-size: 60rpx;"> 请支付：
  <text class="text-price text-red">{{list.order_total_price}}</text>
</view>
<view class="text-center padding" style="font-size: 35rpx;">剩余支付时间：{{minutes}}分:{{seconds}}秒</view>

<view class="padding flex flex-direction new" bind:tap="pays">
  <button class="cu-btn bg-green margin-tb-sm lg">微信支付</button>
</view>