<cu-custom bgColor="bg-gradual-green" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">提交订单</view>
</cu-custom>
<view style="padding: 15rpx;">
  <scroll-view scroll-x class="bg-white nav sby">
    <view class="flex text-center ">
      <view class="cu-item flex-sub {{index==TabCur?'text-green text-bold cur':''}}" wx:for="{{TabCurs}}" wx:key='p' bindtap="tabSelect" data-id="{{index}}">
        <text style="font-size: 30rpx;">{{item}}</text>
      </view>
    </view>
  </scroll-view>
  <!-- 选择地址 -->
  <view class="cu-bar bg-white  solid-bottom" wx:if="{{TabCur==0}}">
    <view class="action text-bold">
      送达时间
    </view>
    <view class="action">
      <text class="cuIcon-deliver_fill text-green" style="padding: 6rpx 7rpx 3rpx 3rpx;"></text>最快30分钟送达
    </view>
  </view>
  <view bind:tap="chooseAddress" wx:if="{{0==TabCur}}">
    <view class="cu-bar bg-white solid-bottom">
      <view class="action">
        收货姓名
      </view>
      <view class="action">
        {{customer_name}}
      </view>
    </view>
    <view class="cu-bar bg-white solid-bottom">
      <view class="action">
        收货电话
      </view>
      <view class="action">
        {{customer_phone}}
      </view>
    </view>
    <view class="cu-bar bg-white solid-bottom">
      <view class="action">
        收货地址
      </view>
      <view class="action">
        {{customer_address}}
      </view>
    </view>
    <view class="cu-bar xby text-green bg-white solid-bottom">
      <view class="action">
        选择其他地址
      </view>
      <view class="action">
        <view class='action'> <text class='cuIcon-right '></text> </view>
      </view>
    </view>

    <!-- 送达时间 -商品 -->
    <view class="fgx"></view>
    <view>
      <view wx:for="{{list}}" wx:key="i">
        <view class="cu-bar by bg-white solid-bottom">
          <view class="action">
            <text class="text-cut" style="width:200px"> {{index+1}}.{{item.product_name}}</text>
          </view>
          <view class="action">
            X {{item.product_quantity}}
          </view>
          <view class="action">
            <text class="text-price text-red"> {{item.total_price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{1==TabCur}}">
    <view class="cu-list menu-avatar ">
      <view class="cu-item ">
        <image class="cu-avatar round lg" src="{{branch_list.branch_logo?branch_list.branch_logo:'/images/logo.jpg'}}" mode="" />
        <view class="content flex-sub ">
          <view class="text-grey">{{branch_list.branch_name}}
            <text class="text-sm" style="padding-left: 30rpx;">距您<text style="padding: 0rpx 18rpx 0rpx 18rpx;">{{distance}}</text>千米</text>
          </view>
          <view class="text-gray text-sm flex justify-between">
            {{branch_list.address}}
          </view>
        </view>
        <view class="action">
          <button class="cu-btn bg-yellow sm" bind:tap="freeTell">电话</button>
          <view style="padding-bottom: 5rpx;"></view>
          <button class="cu-btn bg-blue  sm" bind:tap="openLoca">导航</button>
        </view>
      </view>
    </view>
    <view class="cu-form-group xby">
      <view class="title">取货电话：</view>
      <input placeholder="{{User.phone}}"></input>
    </view>
    <!-- 自提时间 -商品 -->
    <view class="fgx"></view>
    <view class="fgx"></view>

    <view wx:for="{{list}}" wx:key="i">
      <view class="cu-bar by bg-white solid-bottom">
        <view class="action">
          <text class="text-cut" style="width:200px"> {{index+1}}.{{item.product_name}}</text>
        </view>
        <view class="action">
          X {{item.product_quantity}}
        </view>
        <view class="action">
          <text class="text-price text-red"> {{item.meet}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="fgx"></view>
  <view class="fgx"></view>
  <view>
    <view class="cu-bar  sby bg-white solid-bottom">
      <view class="action">
        商品金额
      </view>
      <view class="action">
        <!-- <text class="line-through-text text-price" style="padding: 15rpx;">{{Topr}}</text> -->
        <text class="text-price text-xl  text-black text-bold">{{meet}} </text>
      </view>
    </view>
    <view class="cu-bar xby  bg-white solid-bottom " wx:if="{{TabCur==0}}">
      <view class="action ">
        <text class="{{mjyf==0?'text-orange':'text-black'}}">{{mjyf==0?'商品金额已满'+branch_list.freight_manjian_sum+' 免运费':'运费'}}</text>
      </view>
      <view wx:if="{{mjyf!=0}}" class="text-orange">{{'商品金额满'+branch_list.freight_manjian_sum+'即可免运费'}}</view>
      <view class="action {{mjyf==0?'jym':''}}">
        <text class="text-black text-bold "></text>
        + <text style="padding: 15rpx;" class="text-price text-xl  text-red"> {{branch_list.freight}} </text>
      </view>
    </view>
    <view class="fgx"></view>
    <view wx:if="{{Coupons_sum>0}}" bind:tap="yhq" class="cu-bar {{Coupons?'sby':'by'}}  bg-white  solid-bottom">
      <view class='action'>
        优惠券
      </view>
      <view class='action text-red'>
        有可用优惠券 {{Coupons_sum}}张 <text class='cuIcon-right text-black'></text>
      </view>
    </view>
    <view wx:if="{{Coupons}}" class="cu-bar xby  bg-white solid-bottom">
      <view class="action">
        使用优惠券
      </view>
      <view class="action">
        <text class="text-black text-bold"></text>
        - <text style="padding: 15rpx;" class="text-price text-xl   text-red">{{Coupons.discount_amount}} </text>
      </view>
    </view>
    <view class="fgx"></view>
    <radio-group class="block" bindchange="radioChange">
      <view class="cu-form-group sby">
        <view class="title">余额支付<text class="cuIcon-sponsor text-orange" style="font-size: 40rpx; padding-left: 20rpx;"></text></view>
        <radio checked value="1"></radio>
      </view>
      <view class="cu-form-group  xby">
        <view class="title">微信支付<text class="cuIcon-weixin text-green " style="font-size: 40rpx; padding-left: 20rpx;"></text></view>
        <radio checked value="0"></radio>
      </view>
    </radio-group>
    <view class="fgx"></view>
    <view class="cu-bar  bg-white solid-bottom">
      <view class="action">
        小计
      </view>
      <view class="action">
        <text class="text-black text-bold text-price text-xl">{{meets}} </text>
      </view>
    </view>
    <view class="cu-form-group xby">
      <textarea class="bg-gray" maxlength="-1" bindinput="remarks" placeholder="备注   比如放哪里  联系谁" value="{{description}}"> </textarea>
    </view>
  </view>
</view>
<view class="cu-tabbar-height"></view>
<view class="new cu-bar bg-white tabbar border shop">
  <view class="submit">待支付<text class=" text-bold  text-price text-red" style="font-size: 45rpx; padding-left: 20rpx;">{{meets}}</text></view>
  <!-- <view bind:tap="{{payx==0?'pay':'balance'}}" class="bg-{{payx==0?'green':'orange'}} submit text-bold" style="font-size: 40rpx;">{{payx==0?'微信':'余额'}}支付</view> -->
  <button bind:tap="{{payx==0?'pay':'balance'}}" disabled="{{disableds}}" class="bg-{{payx==0?'green':'orange'}} submit text-bold" style="font-size: 40rpx;">支付</button>
</view>