.tower-swiper .tower-item {
  transform: scale(calc(0.5 + var(--index) / 10));
  margin-left: calc(var(--left) * 100rpx - 150rpx);
  z-index: var(--index);
}

swiper {
  display: block;
  height: 250px;
}
.screen-swiper {
  min-height: 100%;
}


.new {
  width: 100%;
  position: fixed;
  bottom: 0rpx;
}
